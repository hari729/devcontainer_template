# =============================================================================
# BASE LAYER
# Bare ROS2 install + non-root user matching host UID/GID + locale/sudo setup.
# Nothing dev- or project-specific lives here. Build once, reuse everywhere.
# =============================================================================
ARG ROS_DISTRO=jazzy
FROM osrf/ros:${ROS_DISTRO}-desktop

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=${ROS_DISTRO} \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        locales \
        sudo \
        curl \
        ca-certificates \
        gnupg2 \
        lsb-release \
        software-properties-common \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && echo 'soucer /opt/ros/jazzy/setup.bash' >> ~/.bashrc \
    && rm -rf /var/lib/apt/lists/*

# --- Non-root user, UID/GID passed at build time so bind-mounted files
#     created in the container are owned by you on the host, not root. ---
ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN if id -u $USER_UID ; then userdel `id -un $USER_UID` ; fi

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Seed rosdep now so it's cached in this layer; individual project workspaces
# still run `rosdep install` themselves via postCreateCommand.
RUN rosdep update --rosdistro $ROS_DISTRO || true

USER $USERNAME
WORKDIR /home/$USERNAME
ENV USERNAME=$USERNAME

CMD ["bash"]
